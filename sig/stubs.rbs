end

module FFI
  class Struct
    def self.layout: (*untyped) -> void
    def self.by_value: () -> untyped
    def self.by_ref: () -> untyped
    def self.ptr: () -> untyped
    def self.offset_of: (Symbol) -> Integer
    def self.new: () -> untyped
    def []: (Symbol) -> untyped
    def []=: (Symbol, untyped) -> void
  end

  class MemoryPointer
    def self.new: (Symbol, Integer) -> FFI::MemoryPointer
           | (Symbol) -> FFI::MemoryPointer
    def write_bytes: (String) -> FFI::MemoryPointer
    def write_array_of_uint32: (Array[Integer]) -> void
    def read_int: () -> Integer
    def get_uint8: (Integer) -> Integer
    def get_int: (Integer) -> Integer
    def get_uint32: (Integer) -> Integer
    def get_int16: (Integer) -> Integer
    def write_string_length: (String, Integer) -> void
    def put_string: (Integer, String) -> void
    def clear: () -> void
  end

  module Library
  end

  class Function
    def self.new: (Symbol, Array[untyped], untyped, ?blocking: bool) -> untyped
  end
end
