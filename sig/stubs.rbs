    def self.sfSoundStream_stop: (untyped) -> void
  end

  module Ao : Module
    class SampleFormat
      def self.new: () -> untyped
    end
    FMT_NATIVE: Integer

    def self.initialize: () -> void
    def self.default_driver_id: () -> Integer
    def self.open_live: (Integer, untyped, untyped) -> untyped
